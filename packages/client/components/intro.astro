---
import { t, getLanguage } from '@rusthorizons/common/i18n';

let currentLanguage = getLanguage(),
    languages = [
        { locale: 'en', name: 'English' },
        { locale: 'de', name: 'Deutsch' },
        { locale: 'es', name: 'Español' },
        { locale: 'fr', name: 'Français' },
        { locale: 'pt', name: 'Português' },
        { locale: 'ro', name: 'Română' },
        { locale: 'ru', name: 'Русский' },
        { locale: 'tl', name: 'Tagalog'}
    ];
---

<div id="intro">

    <!-- ================== LEFT SIDEBAR ================== -->
    <aside id="home-sidebar">
        <div id="home-sidebar-header">
            <div id="home-logo">
                <img src="/web/logo.png" alt="Modern Horizons" class="home-logo-image" />
                <div class="home-logo-text">
                    <span class="home-logo-title">RUST HORIZONS</span>
                    <span class="home-logo-subtitle">Tactical Survival MMO</span>
                </div>
            </div>
            <button id="sidebar-toggle" title="Collapse sidebar">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 19l-7-7 7-7"/><path d="M18 19l-7-7 7-7"/></svg>
            </button>
        </div>

        <nav id="home-nav">
            <a class="home-nav-item home-nav-active" href="/">
                <svg class="home-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9,22 9,12 15,12 15,22"/></svg>
                <span>Dashboard</span>
            </a>
            <a class="home-nav-item" id="nav-play-link" href="#play">
                <svg class="home-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m14.5 17.5 4-4L21 16l-4 4-2.5-2.5z"/><path d="m3 21 6-6"/><path d="m11 13 6.5-6.5a2.12 2.12 0 0 0-3-3L8 10l3 3z"/></svg>
                <span>Heroes</span>
            </a>
            <a class="home-nav-item" href="#missions">
                <svg class="home-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 21h8"/><path d="M12 17v4"/><path d="M7 4h10v3a5 5 0 0 1-10 0V4Z"/><path d="M17 5h3a2 2 0 0 1-2 2h-1"/><path d="M7 5H4a2 2 0 0 0 2 2h1"/></svg>
                <span>Missions</span>
            </a>
            <a class="home-nav-item" href="#arena">
                <svg class="home-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="3"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a3 3 0 0 1 0 5.74"/></svg>
                <span>Arena (PvP)</span>
            </a>
            <a class="home-nav-item" href="#squad">
                <svg class="home-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
                <span>Squad</span>
            </a>
            <a class="home-nav-item" href="#inventory">
                <svg class="home-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <span>Inventory</span>
            </a>
            <a class="home-nav-item" href="#upgrades">
                <svg class="home-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20"/><path d="M2 12h20"/><path d="m5 5 14 14"/><path d="m19 5-14 14"/></svg>
                <span>Upgrades</span>
            </a>
            <a class="home-nav-item" href="#leaderboards">
                <svg class="home-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-6"/></svg>
                <span>Leaderboards</span>
            </a>
            <a class="home-nav-item" href="#settings">
                <svg class="home-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33h.01a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51h.01a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v.01a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                <span>Settings</span>
            </a>
        </nav>

        <div class="home-nav-gap"></div>

        <div class="home-nav-group-label">Connect</div>
        <nav id="home-nav-secondary">
            <a class="home-nav-item home-nav-sm" href="/">
                <svg class="home-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 13c0 5-3.5 7.5-8 9-4.5-1.5-8-4-8-9V6l8-4 8 4z"/></svg>
                <span>Discord</span>
            </a>
            <a class="home-nav-item home-nav-sm" href="/privacy/">
                <svg class="home-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                <span>Twitter</span>
            </a>
            <a class="home-nav-item home-nav-sm" href="/">
                <svg class="home-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                <span>YouTube</span>
            </a>
        </nav>

        <div id="home-social">
            <a class="home-social-link" href="https://discord.gg/MmbGAaw" target="_blank" title="Discord">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057c.002.022.015.04.033.05a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/></svg>
            </a>
            <a class="home-social-link" href="https://github.com/4tunexx/rusthorizons" target="_blank" title="GitHub">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
            </a>
            <a class="home-social-link" href="https://www.patreon.com/bePatron?u=29287394" target="_blank" title="Patreon">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M14.82 2.41c3.96 0 7.18 3.24 7.18 7.21 0 3.96-3.22 7.18-7.18 7.18-3.97 0-7.21-3.22-7.21-7.18 0-3.97 3.24-7.21 7.21-7.21M2 21.6h3.5V2.41H2V21.6z"/></svg>
            </a>
        </div>

        <div id="home-live-support">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/></svg>
            <span>SUPPORT</span>
        </div>
    </aside>

    <!-- ══════════════════ MAIN CONTENT ══════════════════ -->
    <main id="home-main">

        <!-- Hero Banner -->
        <section id="home-hero">
            <div id="home-hero-text">
                <div class="home-hero-tag">🎯 CURRENT OPERATION PANEL</div>
                <h1 id="home-hero-heading">OPERATION IRON<br/>COLLAPSE</h1>
                <p>Flux Storm Incoming. Deploy your hero squad into fractured wasteland sectors, secure extraction zones, and push your Power Rating through tactical PvE/PvP operations.</p>
                <div id="home-hero-btns">
                    <button class="hero-btn-primary" id="nav-play-btn">
                        <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14"><polygon points="5,3 19,12 5,21"/></svg>
                        LAUNCH GAME
                    </button>
                    <button class="hero-btn-secondary">SQUAD LOADOUT</button>
                </div>
            </div>
            <div id="home-hero-art">
                <img src="/web/c1.png" alt="Class One" class="home-hero-character-img c1" />
                <img src="/web/c2.png" alt="Class Two" class="home-hero-character-img c2" />
            </div>
            <div id="home-featured-card">
                <div class="hfc-header">
                    <div class="hfc-avatar"><div class="hfc-avatar-inner">RH</div></div>
                    <div class="hfc-title-block">
                        <div class="hfc-title">MODERN HORIZONS <span class="hfc-star">★</span></div>
                        <div class="hfc-badge">● LIVE</div>
                    </div>
                </div>
                <div class="hfc-tagline">Rank: Wasteland Vanguard</div>
                <div class="hfc-meta">Member since: <strong>Jan 2024</strong></div>
                <div class="hfc-meta">Operations completed: <strong>42</strong></div>
                <div class="hfc-stats">
                    <div class="hfc-stat"><span class="hfc-stat-label">XP / hour</span><span class="hfc-stat-val gold">1,177 XP</span></div>
                    <div class="hfc-stat"><span class="hfc-stat-label">Power Score</span><span class="hfc-stat-val gold">5,123</span></div>
                    <div class="hfc-stat"><span class="hfc-stat-label">PvP Win Rate</span><span class="hfc-stat-val green">+65.7%</span></div>
                    <div class="hfc-stat"><span class="hfc-stat-label">Achievements</span><span class="hfc-stat-val gold">260</span></div>
                </div>
                <div class="hfc-actions">
                    <button class="hfc-btn">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/></svg>
                        SQUAD COMMS
                    </button>
                    <button class="hfc-btn">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                        ARENA BOARD
                    </button>
                </div>
            </div>
        </section>

        <!-- Achievements Section -->
        <section id="home-achievements">
            <div class="home-section-header">
                <div class="home-section-icon">⚔️</div>
                <h2>HERO MILESTONES</h2>
                <div class="home-section-controls">
                    <button class="home-ctrl-btn">‹</button>
                    <button class="home-ctrl-btn active">›</button>
                    <a class="home-see-all" href="/">See all</a>
                </div>
            </div>
            <div class="home-ach-grid">
                <div class="home-ach-card">
                    <div class="home-ach-icon" style="background:linear-gradient(145deg,#0d3d78,#1a6fc4);box-shadow:0 4px 18px rgba(30,100,220,0.45);border-color:rgba(60,140,255,0.3)"><span>⚡</span></div>
                    <div class="home-ach-body">
                        <strong>FIRST BLOOD</strong>
                        <p>Win your first tactical mission.</p>
                        <div class="home-ach-prog"><div class="home-ach-bar" style="width:30%"></div></div>
                        <span class="home-ach-count">Reward: 350 XP</span>
                    </div>
                </div>
                <div class="home-ach-card">
                    <div class="home-ach-icon" style="background:linear-gradient(145deg,#7a1500,#c43010);box-shadow:0 4px 18px rgba(220,60,20,0.45);border-color:rgba(255,80,30,0.3)"><span>🔥</span></div>
                    <div class="home-ach-body">
                        <strong>FLUX MASTER</strong>
                        <p>Maintain full Flux Energy through 5 matches.</p>
                        <div class="home-ach-prog"><div class="home-ach-bar" style="width:10%"></div></div>
                        <span class="home-ach-count">Reward: 500 Credits</span>
                    </div>
                </div>
                <div class="home-ach-card">
                    <div class="home-ach-icon" style="background:linear-gradient(145deg,#4a0d8c,#7c22d4);box-shadow:0 4px 18px rgba(140,40,220,0.45);border-color:rgba(160,80,255,0.3)"><span>⏳</span></div>
                    <div class="home-ach-body">
                        <strong>SHIELD BREAKER</strong>
                        <p>Destroy 100 shield units in Arena encounters.</p>
                        <div class="home-ach-prog"><div class="home-ach-bar" style="width:10%"></div></div>
                        <span class="home-ach-count">Reward: 800 XP</span>
                    </div>
                </div>
                <div class="home-ach-card">
                    <div class="home-ach-icon" style="background:linear-gradient(145deg,#0a5c28,#12a04a);box-shadow:0 4px 18px rgba(20,180,80,0.4);border-color:rgba(40,200,90,0.3)"><span>🛡️</span></div>
                    <div class="home-ach-body">
                        <strong>ARENA DOMINATOR</strong>
                        <p>Secure 10 PvP victories in ranked mode.</p>
                        <div class="home-ach-prog"><div class="home-ach-bar green" style="width:100%"></div></div>
                        <span class="home-ach-count done">Reward: Epic Cosmetic</span>
                    </div>
                </div>
                <div class="home-ach-card">
                    <div class="home-ach-icon" style="background:linear-gradient(145deg,#0e4b7d,#00a9dd);box-shadow:0 4px 18px rgba(0,180,255,0.4);border-color:rgba(0,210,255,0.3)"><span>🛰️</span></div>
                    <div class="home-ach-body">
                        <strong>MISSION SPECIALIST</strong>
                        <p>Complete 25 operation objectives without squad wipe.</p>
                        <div class="home-ach-prog"><div class="home-ach-bar" style="width:42%"></div></div>
                        <span class="home-ach-count">Reward: 1200 XP</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Activity Table -->
        <section id="home-activity">
            <div class="home-act-grid">
                <span class="home-act-header">Mode</span>
                <span class="home-act-header">Hero Used</span>
                <span class="home-act-header">Result</span>
                <span class="home-act-header">Duration</span>
                <span class="home-act-header">Damage Done</span>
                <span class="home-act-header">Rank Points Gained</span>

                <div class="home-act-game"><div class="home-act-game-icon">🛡️</div><div><strong>PvE</strong><span>Operation Sector-9</span></div></div>
                <span class="home-act-cell">Ranger C1</span>
                <span class="home-act-cell"><span class="home-badge green">Victory</span></span>
                <span class="home-act-cell muted">12m 41s</span>
                <span class="home-act-cell gold">18,420</span>
                <span class="home-act-cell"><span class="home-win">+42 RP</span></span>

                <div class="home-act-game"><div class="home-act-game-icon">⚔️</div><div><strong>PvP</strong><span>Arena Grid</span></div></div>
                <span class="home-act-cell">Valkyrie C2</span>
                <span class="home-act-cell"><span class="home-badge red">Defeat</span></span>
                <span class="home-act-cell muted">08m 09s</span>
                <span class="home-act-cell gold">11,233</span>
                <span class="home-act-cell"><span class="home-loss">-16 RP</span></span>

                <div class="home-act-game"><div class="home-act-game-icon">🛰️</div><div><strong>PvE</strong><span>Recon Sweep</span></div></div>
                <span class="home-act-cell">Operator C3</span>
                <span class="home-act-cell"><span class="home-badge green">Victory</span></span>
                <span class="home-act-cell muted">15m 03s</span>
                <span class="home-act-cell gold">22,981</span>
                <span class="home-act-cell"><span class="home-win">+51 RP</span></span>

                <div class="home-act-game"><div class="home-act-game-icon">🏹</div><div><strong>PvP</strong><span>Duel Protocol</span></div></div>
                <span class="home-act-cell">Sniper C1</span>
                <span class="home-act-cell"><span class="home-badge green">Victory</span></span>
                <span class="home-act-cell muted">06m 47s</span>
                <span class="home-act-cell gold">14,622</span>
                <span class="home-act-cell"><span class="home-win">+28 RP</span></span>

                <div class="home-act-game"><div class="home-act-game-icon">🔧</div><div><strong>PvE</strong><span>Defense Hold</span></div></div>
                <span class="home-act-cell">Engineer C4</span>
                <span class="home-act-cell"><span class="home-badge red">Defeat</span></span>
                <span class="home-act-cell muted">09m 20s</span>
                <span class="home-act-cell gold">9,303</span>
                <span class="home-act-cell"><span class="home-loss">-10 RP</span></span>

                <div class="home-act-game"><div class="home-act-game-icon">⚡</div><div><strong>PvP</strong><span>Arena Grid</span></div></div>
                <span class="home-act-cell">Fluxblade C2</span>
                <span class="home-act-cell"><span class="home-badge green">Victory</span></span>
                <span class="home-act-cell muted">07m 10s</span>
                <span class="home-act-cell gold">16,844</span>
                <span class="home-act-cell"><span class="home-win">+33 RP</span></span>
            </div>
        </section>
    </main>

    <!-- ══════════════════ RIGHT PANEL ══════════════════ -->
    <aside id="home-right">

        <!-- Player Profile Widget -->
        <div id="home-player-profile">
            <div class="hpp-banner"></div>
            <div class="hpp-body">
                <div class="hpp-avatar">RH</div>
                <div class="hpp-name">Neomodeon // Vanguard</div>
                <div class="hpp-tag">neomodeon#222</div>
                <div class="hpp-level-row">
                    <span class="hpp-level-badge">LVL 21 // V</span>
                    <div class="hpp-xp-bar"><div class="hpp-xp-bar-fill"></div></div>
                    <span class="hpp-xp-text">12,767 / 14,000 XP</span>
                </div>
                <div class="hpp-stats">
                    <div class="hpp-stat-row">
                        <span class="hpp-stat-label"><span class="hpp-stat-icon">⚡</span> Total Power Score</span>
                        <span class="hpp-stat-val">12,117</span>
                    </div>
                    <div class="hpp-stat-row">
                        <span class="hpp-stat-label"><span class="hpp-stat-icon">🧪</span> Flux Energy</span>
                        <span class="hpp-stat-val">1,112</span>
                    </div>
                    <div class="hpp-stat-row">
                        <span class="hpp-stat-label"><span class="hpp-stat-icon">🏅</span> PvP Win Rate</span>
                        <span class="hpp-stat-val">63%</span>
                    </div>
                    <div class="hpp-stat-row">
                        <span class="hpp-stat-label"><span class="hpp-stat-icon">💠</span> Credits</span>
                        <span class="hpp-stat-val">8,420</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Mission Reward Cache -->
        <div id="home-rewards-cache">
            <div class="hb-chest">🎯</div>
            <div class="hb-info">
                <strong>MISSION REWARD CACHE</strong>
                <p>Operation Iron Collapse rewards refreshed.</p>
            </div>
            <div class="hb-right">
                <div class="hb-timer">02:39</div>
                <button class="hb-btn">Claim Rewards</button>
            </div>
        </div>

        <!-- Login / Register Panel -->
        <section id="parchment" class="load-character slice-menu-fancy">
        <article id="load-character">
            <h1 class="title-decoration">{t('game:NAME')}</h1>

