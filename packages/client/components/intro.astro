<script>
    // Sidebar collapse toggle
    const toggleBtn = document.getElementById('sidebar-toggle');
    const intro = document.getElementById('intro');
    if (toggleBtn && intro) {
        const STORAGE_KEY = 'rh-sidebar-collapsed';
        if (localStorage.getItem(STORAGE_KEY) === '1') {
            intro.classList.add('sidebar-collapsed');
        }
        toggleBtn.addEventListener('click', () => {
            intro.classList.toggle('sidebar-collapsed');
            localStorage.setItem(STORAGE_KEY, intro.classList.contains('sidebar-collapsed') ? '1' : '0');
        });
    }
    // Hero play button alias
    const navPlayBtn = document.getElementById('nav-play-btn');
    const navPlayLink = document.getElementById('nav-play-link');
    if (navPlayBtn && navPlayLink) {
        navPlayBtn.addEventListener('click', () => navPlayLink.click());
    }
</script>
